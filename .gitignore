# SPM build artefacts
.build/
.swiftpm/
DerivedData/

# Package.resolved is deliberately tracked — a binary grammar dependency has to
# pin to an exact revision, or a fresh checkout can silently resolve a different
# xcframework.

# stray swift compile outputs (in case they leak out of .build/)
*.o
*.d
*.swiftdeps
*.swiftmodule
*.swiftsourceinfo

# Built app bundle (output of `make app`)
Bob.app/

# bench profiles — big and noisy; the .md results are committed
bench/results/*.sample.txt

# Xcode (if anyone opens this in Xcode)
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# macOS
.DS_Store

# Local-only config
.env
.env.local
